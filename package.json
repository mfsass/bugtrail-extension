{
  "name": "bughunter-extension",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "postinstall": "wxt prepare",
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "sync:brand": "node scripts/sync-brand-assets.mjs",
    "build": "npm run sync:brand && wxt build",
    "zip": "wxt zip",
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "audit:prod": "npm audit --omit=dev",
    "validate:package": "node scripts/validate-extension-package.mjs",
    "validate:docs": "node scripts/validate-docs.mjs",
    "release:metadata": "node scripts/write-release-metadata.mjs",
    "validate:release-metadata": "node scripts/validate-release-metadata.mjs",
    "smoke:runtime": "node scripts/runtime-smoke.mjs",
    "capture:store": "npm run build && node scripts/capture-store-assets.mjs",
    "verify": "npm test && npm run compile && npm run build && npm run validate:package && npm run validate:docs && npm run audit:prod",
    "verify:release": "npm run verify && npm run zip && npm run release:metadata && npm run validate:release-metadata && npm run smoke:runtime"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.318",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.5.0",
    "@wxt-dev/module-react": "^1.1.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.2",
    "wxt": "^0.20.6"
  }
}
